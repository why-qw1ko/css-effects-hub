  .view-all-link:hover { gap: 10px; }
  .view-all-link svg { width: 15px; height: 15px; }

  /* ============ 工作流 ============ */
  .step-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .step-card {
    position: relative;
    padding: 26px 24px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .step-index {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.08em;
  }
  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--primary-dim);
    color: var(--primary);
  }
  .step-icon svg { width: 19px; height: 19px; }
  .step-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .step-desc {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .step-arrow {
    position: absolute;
    top: 50%;
    right: -19px;
    transform: translateY(-50%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
  }
  .step-arrow svg { width: 12px; height: 12px; }

  /* ============ CTA Band ============ */
  .cta-band {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 64px 40px;
    border-radius: 24px;
    background: linear-gradient(120deg, var(--primary), #8b5cf6 60%, #a855f7);
  }
  .cta-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle 300px at 20% 20%, rgba(255, 255, 255, 0.18), transparent 70%),
      radial-gradient(circle 260px at 85% 80%, rgba(255, 255, 255, 0.12), transparent 70%);
  }
  .cta-title {
    position: relative;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: #fff;
    margin-bottom: 12px;
  }
  .cta-desc {
    position: relative;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 30px;
  }
  .cta-actions {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 30px;
    background: #fff;
    color: var(--primary);
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }
  .cta-btn-primary:hover {
    transform: scale(1.04);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.2);
  }
  .cta-btn-primary svg { width: 16px; height: 16px; }
  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 26px;
    background: transparent;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .cta-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.7);
  }

  /* ============ 响应式 ============ */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 44px;
      padding: 40px 24px 72px;
      text-align: center;
    }
    .hero-copy { max-width: 620px; margin: 0 auto; }
    .hero-desc { margin-left: auto; margin-right: auto; }
    .hero-cta-row, .hero-trust { justify-content: center; }
    .hero-window { max-width: 480px; margin: 0 auto; width: 100%; }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .feat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { min-height: auto; }
    .hero-scroll-hint { display: none; }
    .hero-orb { filter: blur(44px); }
    .section { padding: 0 20px 64px; }
    .section-last { padding-bottom: 72px; }
    .stats-band { margin-bottom: 64px; }
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
      padding: 30px 20px;
    }
    /* 2×2 布局下取消中缝分隔线，仅保留每行第二项左侧 */
    .stat-item + .stat-item { border-left: none; }
    .stat-item:nth-child(even) { border-left: 1px solid var(--border); }
    .step-row { grid-template-columns: 1fr; }
    .step-arrow { display: none; }
    .section-head-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .cta-band { padding: 48px 24px; }
  }
  @media (max-width: 560px) {
    .hero-inner { padding: 32px 18px 60px; }
    .hero-badge { font-size: 11px; }
    .hero-cta-row { flex-direction: column; align-items: stretch; }
    .hero-cta-primary, .hero-cta-secondary { width: 100%; }
    .hero-trust { gap: 12px; }
    .feature-grid { grid-template-columns: 1fr; }
    .feat-grid { grid-template-columns: 1fr; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-actions { flex-direction: column; align-items: stretch; }
  }

  /* ============ 降级：减少动态效果 ============ */
  @media (prefers-reduced-motion: reduce) {
    .hero-line { animation: none; opacity: 1; transform: translateY(0); }
    .hero-scroll-hint { animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
    .hero-grid, .hero-spot { display: none; }
  }
  /* 触屏设备无 hover：显示静态柔光 */
  @media (hover: none) {
    .hero-spot {
      opacity: 1;
      background: radial-gradient(
        circle 320px at 50% 32%,
        color-mix(in srgb, var(--primary) 10%, transparent),
        transparent 70%
      );
    }
    .hero-grid { display: none; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover)').matches;

  /* ---------- 滚动显现：可重复触发（离开视口后重置，再次进入重播） ---------- */
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  const pendingReveal = new WeakMap<Element, ReturnType<typeof setTimeout>>();
  if (reduced) {
    reveals.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            // stagger 延迟用 JS 定时器实现，避免 transition-delay 拖慢 hover 反馈
            const delay = parseFloat(el.dataset.rd || '0') * 1000;
            if (delay > 0) {
              pendingReveal.set(el, setTimeout(() => el.classList.add('in'), delay));
            } else {
              el.classList.add('in');
            }
          } else {
            const t = pendingReveal.get(el);
            if (t !== undefined) clearTimeout(t);
            el.classList.remove('in');
          }
        });
      },
      { threshold: 0.12 }
    );
    reveals.forEach((el) => io.observe(el));
  }

  /* ---------- 数字跳动：进入视口播放，离开重置，可重复 ---------- */
  const statsWrap = document.getElementById('statsWrap');
  const counterRafs = new WeakMap<Element, number>();

  function animateCounter(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const suffix = el.dataset.suffix || '';
    const duration = 1600;
    let start: number | null = null;
    function step(ts: number) {
      if (start === null) start = ts;
      const p = Math.min((ts - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.floor(eased * target).toLocaleString() + suffix;
      if (p < 1) counterRafs.set(el, requestAnimationFrame(step));
    }
    counterRafs.set(el, requestAnimationFrame(step));
  }

  function resetCounter(el: HTMLElement) {
    const raf = counterRafs.get(el);
    if (raf !== undefined) cancelAnimationFrame(raf);
    el.textContent = '0';
  }

  if (statsWrap) {
    const nums = Array.from(statsWrap.querySelectorAll<HTMLElement>('.stat-num'));
    if (reduced) {
      nums.forEach((el) => {
        el.textContent = parseInt(el.dataset.target || '0', 10).toLocaleString() + (el.dataset.suffix || '');
      });
    } else {
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              nums.forEach(animateCounter);
            } else {
              nums.forEach(resetCounter);
            }
          });
        },
        { threshold: 0.3 }
      );
      cio.observe(statsWrap);
    }
  }

  /* ---------- Hero：聚光灯 + 视差（光球 + 产品视窗统一处理） ---------- */
  const hero = document.getElementById('hero');
  const heroGrid = document.getElementById('heroGrid');
  const heroSpot = document.getElementById('heroSpot');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.hero-orb, .hero-window'));

  if (hero && !reduced) {
    let scrollY = 0;
    let mouseX = 0; // 相对中心的归一化偏移 [-0.5, 0.5]
    let mouseY = 0;
    let raf = 0;

    function applyLayerTransforms() {
      raf = 0;
      layers.forEach((layer) => {
        const speed = parseFloat(layer.dataset.speed || '0');
        const depth = parseFloat(layer.dataset.depth || '0');
        layer.style.setProperty('--px', mouseX * depth + 'px');
        layer.style.setProperty('--py', scrollY * speed + mouseY * depth + 'px');
      });
    }
    function scheduleLayers() {
      if (!raf) raf = requestAnimationFrame(applyLayerTransforms);
    }

    // 滚动视差（rAF 节流，与全局进度条脚本互不干扰）
    window.addEventListener(
      'scroll',
      () => {
        scrollY = window.scrollY;
        scheduleLayers();
      },
      { passive: true }
    );

    if (canHover) {
      hero.addEventListener('mousemove', (e) => {
        const rect = hero.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        // 聚光灯位置
        const mx = x + 'px';
        const my = y + 'px';
        heroGrid?.style.setProperty('--mx', mx);
        heroGrid?.style.setProperty('--my', my);
        heroSpot?.style.setProperty('--mx', mx);
        heroSpot?.style.setProperty('--my', my);
        hero.classList.add('spot-on');
        // 鼠标视差
        mouseX = x / rect.width - 0.5;
        mouseY = y / rect.height - 0.5;
        scheduleLayers();
      });
      hero.addEventListener('mouseleave', () => {
        hero.classList.remove('spot-on');
        mouseX = 0;
        mouseY = 0;
        scheduleLayers();
      });
    }
  }

  /* ---------- 磁吸主 CTA ---------- */
  const magnetic = document.getElementById('magneticCta');
  if (magnetic && hero && !reduced && canHover) {
    const strength = 0.3;
    const threshold = 120;
    hero.addEventListener('mousemove', (e) => {
      const rect = magnetic.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < threshold) {
        const f = (1 - dist / threshold) * strength;
        magnetic.style.transform = `translate(${dx * f}px, ${dy * f}px)`;
        magnetic.style.transition = 'box-shadow 0.3s ease, background 0.2s ease';
      } else {
        magnetic.style.transform = '';
        magnetic.style.transition = 'box-shadow 0.3s ease, background 0.2s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
      }
    });
    hero.addEventListener('mouseleave', () => {
      magnetic.style.transform = '';
      magnetic.style.transition = 'box-shadow 0.3s ease, background 0.2s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
    });
  }
</script>
