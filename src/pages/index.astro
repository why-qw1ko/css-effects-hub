  .feat-info { padding: 14px 16px; }
  .feat-name-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }
  .feat-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
  }
  .feat-name-en {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .feat-tags { display: flex; gap: 6px; }
  .feat-tag {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 100px;
    background: var(--primary-dim);
    color: var(--primary);
