---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';
import { effects, categories } from '../data/effects';

const base = import.meta.env.BASE_URL;

// 首页统计数据（来自真实数据源）
const totalEffects = effects.length;
const totalCategories = categories.length;
const advancedCount = 26;

// 分类图标：统一使用 lucide 图标库（UI 层禁用 emoji）
const categoryIcons: Record<string, string> = {
  basic: 'lucide:play',
  text: 'lucide:type',
  color: 'lucide:palette',
  geometry: 'lucide:shapes',
  loading: 'lucide:loader',
  hover: 'lucide:mouse-pointer',
  scroll: 'lucide:mouse',
  button: 'lucide:pointer',
  transition: 'lucide:arrow-right-left',
  advanced: 'lucide:rocket',
  micro: 'lucide:zap',
};

// Hero 产品视窗：4 个实时预览，代表产品核心体验
const windowChipIds = ['gradient-flow', 'typewriter', 'rainbow-border', 'glow-pulse'];
const windowChips = windowChipIds
  .map((id) => effects.find((e) => e.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// 核心能力
const features = [
  { icon: 'lucide:eye', title: '实时预览', desc: '每个动效均以真实 CSS 渲染，所见即所得，无需安装即可评估效果。' },
  { icon: 'lucide:copy', title: '一键复制', desc: 'HTML 与 CSS 源码结构清晰、注释完整，复制后可直接投入生产环境。' },
  { icon: 'lucide:bot', title: 'AI Prompt 就绪', desc: '每个动效附带精心编写的 Prompt，交给任意 AI 助手即可复现与定制。' },
  { icon: 'lucide:feather', title: '零依赖纯 CSS', desc: '不引入任何运行时库，无框架绑定，任何技术栈均可无缝集成。' },
  { icon: 'lucide:moon', title: '深色模式适配', desc: '全站动效在浅色与深色主题下均经过校准，视觉表现始终如一。' },
  { icon: 'lucide:refresh-cw', title: '持续更新', desc: '动效库持续扩充与打磨，高级交互效果定期上新。' },
];

// 精选动效：从动效库中挑选视觉表现力强的条目做实时预览
const featuredIds = ['neon-text', 'typewriter', 'gradient-flow', 'rainbow-border', 'glitch', 'glow-pulse'];
const featured = featuredIds
  .map((id) => effects.find((e) => e.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// 工作流
const steps = [
  { icon: 'lucide:search', title: '挑选动效', desc: '按分类或关键词检索，实时预览确认效果。' },
  { icon: 'lucide:clipboard-copy', title: '复制代码', desc: '获取完整 HTML / CSS 源码，或直接取用 AI Prompt。' },
  { icon: 'lucide:rocket', title: '集成上线', desc: '粘贴进项目即可运行，零依赖，无需二次调试。' },
];

const categoryName = (id: string) => categories.find((c) => c.id === id)?.name ?? '';
const difficultyLabel: Record<string, string> = { easy: '入门', medium: '进阶', hard: '高级' };
---

<MainLayout>
  <div class="min-h-screen">
    <!-- ============ 1. Hero：聚光灯揭示 + 视差 + 产品视窗 ============ -->
    <section class="hero" id="hero">
      <div class="hero-grid" id="heroGrid" aria-hidden="true"></div>
      <div class="hero-spot" id="heroSpot" aria-hidden="true"></div>
      <div class="hero-orb orb-a" data-speed="0.22" data-depth="18" aria-hidden="true"></div>
      <div class="hero-orb orb-b" data-speed="0.38" data-depth="30" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="hero-copy">
          <div class="hero-line hero-badge" style="--d:0s">
            <Icon name="lucide:sparkles" />
            <span class="font-sans">{totalEffects} 个动效 · {advancedCount} 个高级交互 · 持续更新</span>
          </div>
          <h1 class="hero-title font-display">
            <span class="hero-line block" style="--d:0.08s">为现代 Web 打造的</span>
            <span class="hero-line hero-title-grad block" style="--d:0.18s">CSS 动效库</span>
          </h1>
          <p class="hero-line hero-desc font-sans" style="--d:0.3s">
            覆盖 {totalCategories} 大类的生产级 CSS 动效，附完整源码与 AI Prompt。
            实时预览、开箱即用，帮助团队快速交付高品质交互体验。
          </p>
          <div class="hero-line hero-cta-row" style="--d:0.42s">
            <a href={`${base}effects`} class="hero-cta-primary" id="magneticCta">
              开始使用
              <Icon name="lucide:arrow-right" />
            </a>
            <a href={`${base}advanced`} class="hero-cta-secondary">
              <Icon name="lucide:sparkles" />
              查看高级动效
            </a>
          </div>
          <div class="hero-line hero-trust font-sans" style="--d:0.52s">
            <span class="trust-item"><Icon name="lucide:check" />纯 CSS 零依赖</span>
            <span class="trust-item"><Icon name="lucide:check" />深色模式</span>
            <span class="trust-item"><Icon name="lucide:check" />响应式适配</span>
          </div>
        </div>

        <!-- 产品视窗：浏览器框 + 实时动效预览 -->
        <div class="hero-window hero-line" data-depth="10" data-speed="0.05" style="--d:0.5s">
          <div class="hw-bar">
            <span class="hw-dot" style="background:#ff5f57"></span>
            <span class="hw-dot" style="background:#febc2e"></span>
            <span class="hw-dot" style="background:#28c840"></span>
            <span class="hw-url font-mono">css-effects-hub</span>
          </div>
          <div class="hw-grid">
            {windowChips.map((fx) => (
              <div class="hw-cell">
                <div class="hw-preview" set:html={fx.previewHtml} />
                <span class="hw-label font-mono">{fx.nameEn}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="hero-scroll-hint" aria-hidden="true">
        <span class="font-mono">SCROLL</span>
        <Icon name="lucide:chevron-down" />
      </div>
    </section>

    <!-- ============ 2. 数据带：数字跳动（可重复） ============ -->
    <section class="stats-band">
      <div class="stats-inner reveal" id="statsWrap">
        <div class="stat-item">
          <span class="stat-num font-display" data-target={totalEffects}>0</span>
          <span class="stat-label font-sans">生产级动效</span>
        </div>
        <div class="stat-item">
          <span class="stat-num font-display" data-target={totalCategories}>0</span>
          <span class="stat-label font-sans">效果分类</span>
        </div>
        <div class="stat-item">
          <span class="stat-num font-display" data-target={advancedCount}>0</span>
          <span class="stat-label font-sans">高级交互效果</span>
        </div>
        <div class="stat-item">
          <span class="stat-num font-display" data-target="100" data-suffix="%">0</span>
          <span class="stat-label font-sans">附源码与 Prompt</span>
        </div>
      </div>
    </section>

    <!-- ============ 3. 核心能力 ============ -->
    <section class="section">
      <div class="section-head reveal">
        <span class="section-eyebrow font-mono">Capabilities</span>
        <h2 class="section-title font-display">从预览到上线，一站式完成</h2>
        <p class="section-desc font-sans">围绕动效交付的完整链路设计，每个环节都为效率服务。</p>
      </div>
      <div class="feature-grid">
        {features.map((f, i) => (
          <div class="feature-card reveal" data-rd={String(i * 0.06)}>
            <div class="feature-icon"><Icon name={f.icon} /></div>
            <h3 class="feature-title font-display">{f.title}</h3>
            <p class="feature-desc font-sans">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ 4. 分类导航 ============ -->
    <section class="section">
      <div class="section-head reveal">
        <span class="section-eyebrow font-mono">Categories</span>
        <h2 class="section-title font-display">{totalCategories} 大分类，覆盖常见交互场景</h2>
        <p class="section-desc font-sans">从基础入场到高级视觉效果，按需取用。</p>
      </div>
      <div class="cat-grid">
        {categories.map((cat, i) => (
          <a href={`${base}effects`} class="cat-card reveal" data-rd={String(i * 0.04)}>
            <span class="cat-icon"><Icon name={categoryIcons[cat.id] ?? 'lucide:sparkles'} /></span>
            <span class="cat-name font-display">{cat.name}</span>
            <span class="cat-meta font-mono">{cat.nameEn} · {cat.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ 5. 精选动效 ============ -->
    <section class="section">
      <div class="section-head section-head-row reveal">
        <div>
          <span class="section-eyebrow font-mono">Featured</span>
          <h2 class="section-title font-display">精选动效</h2>
          <p class="section-desc font-sans">每个条目均可查看完整实现与 AI Prompt。</p>
        </div>
        <a href={`${base}effects`} class="view-all-link font-sans">
          查看全部 {totalEffects} 个
          <Icon name="lucide:arrow-right" />
        </a>
      </div>
      <div class="feat-grid">
        {featured.map((fx, i) => (
          <a href={`${base}effect/${fx.id}`} class="feat-card reveal" data-rd={String(i * 0.07)}>
            <div class="feat-preview" set:html={fx.previewHtml} />
            <div class="feat-info">
              <div class="feat-name-row">
                <span class="feat-name font-display">{fx.name}</span>
                <span class="feat-name-en font-mono">{fx.nameEn}</span>
              </div>
              <div class="feat-tags">
                <span class="feat-tag">{categoryName(fx.category)}</span>
                <span class="feat-tag feat-tag-lv">{difficultyLabel[fx.difficulty] ?? fx.difficulty}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ 6. 工作流 ============ -->
    <section class="section">
      <div class="section-head reveal">
        <span class="section-eyebrow font-mono">Workflow</span>
        <h2 class="section-title font-display">三步接入你的项目</h2>
        <p class="section-desc font-sans">无学习成本，从挑选到上线只需几分钟。</p>
      </div>
      <div class="step-row">
        {steps.map((s, i) => (
          <div class="step-card reveal" data-rd={String(i * 0.1)}>
            <div class="step-head">
              <span class="step-index font-mono">0{i + 1}</span>
              <span class="step-icon"><Icon name={s.icon} /></span>
            </div>
            <h3 class="step-title font-display">{s.title}</h3>
            <p class="step-desc font-sans">{s.desc}</p>
            {i < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="lucide:arrow-right" /></span>}
          </div>
        ))}
      </div>
    </section>

    <!-- ============ 7. CTA Band ============ -->
    <section class="section section-last">
      <div class="cta-band reveal">
        <div class="cta-glow" aria-hidden="true"></div>
        <h2 class="cta-title font-display">现在就把动效带进你的项目</h2>
        <p class="cta-desc font-sans">{totalEffects} 个动效与 {advancedCount} 个高级交互效果，全部免费开放。</p>
        <div class="cta-actions">
          <a href={`${base}effects`} class="cta-btn-primary font-sans">
            进入动效库
            <Icon name="lucide:arrow-right" />
          </a>
          <a href={`${base}themes`} class="cta-btn-ghost font-sans">
            浏览主题库
          </a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  /* ============ Hero ============ */
  .hero {
    position: relative;
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg) 0%, var(--surface) 100%);
  }

  /* 网格纹理：由聚光灯 mask 揭示 */
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0;
    transition: opacity 0.4s ease;
    -webkit-mask-image: radial-gradient(circle 240px at var(--mx, 50%) var(--my, 40%), #000 0%, transparent 100%);
    mask-image: radial-gradient(circle 240px at var(--mx, 50%) var(--my, 40%), #000 0%, transparent 100%);
  }
  .hero.spot-on .hero-grid { opacity: 0.75; }

  .hero-spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      circle 280px at var(--mx, 50%) var(--my, 40%),
      color-mix(in srgb, var(--primary) 12%, transparent),
      transparent 70%
    );
  }
  .hero.spot-on .hero-spot { opacity: 1; }

  /* 视差光球：位移统一走 CSS 变量，避免与其他 transform 冲突 */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    will-change: transform;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
  }
  .orb-a {
    width: 360px; height: 360px;
    top: 6%; left: 4%;
    background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--primary) 26%, transparent), transparent 70%);
  }
  .orb-b {
    width: 280px; height: 280px;
    bottom: 8%; right: 6%;
    background: radial-gradient(circle at 30% 30%, rgba(168, 85, 247, 0.22), transparent 70%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    padding: 48px 32px 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    align-items: center;
    gap: 56px;
  }
  .hero-copy { max-width: 580px; }

  /* 逐行错峰入场 */
  .hero-line {
    opacity: 0;
    transform: translateY(24px);
    animation: heroUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes heroUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 22px;
  }
  .hero-badge svg { width: 13px; height: 13px; color: var(--primary); }

  .hero-title {
    font-size: clamp(36px, 6vw, 62px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.14;
    color: var(--text);
    margin-bottom: 20px;
  }
  .hero-title-grad {
    background: linear-gradient(100deg, var(--primary), #8b5cf6 55%, #ec4899);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero-desc {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 30px;
    background: var(--primary);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 18px color-mix(in srgb, var(--primary) 32%, transparent);
    transition: box-shadow 0.3s ease, background 0.2s ease;
    will-change: transform;
  }
  .hero-cta-primary:hover {
    background: var(--primary-hover);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--primary) 45%, transparent);
  }
  .hero-cta-primary svg,
  .hero-cta-secondary svg { width: 16px; height: 16px; }
  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 26px;
    background: var(--card);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .hero-cta-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .trust-item svg { width: 13px; height: 13px; color: var(--primary); }

  /* 产品视窗 */
  .hero-window {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.12);
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    will-change: transform;
  }
  .hw-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .hw-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hw-url {
    margin-left: 10px;
    padding: 3px 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 10px;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }
  .hw-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
  }
  .hw-cell {
    display: flex;
    flex-direction: column;
    background: var(--card);
  }
  .hw-preview {
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    overflow: hidden;
  }
  .hw-label {
    padding: 8px 12px;
    font-size: 10px;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    border-top: 1px solid var(--border);
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: var(--text-tertiary);
    font-size: 10px;
    letter-spacing: 0.2em;
    animation: hintFloat 2.2s ease-in-out infinite;
  }
  .hero-scroll-hint svg { width: 16px; height: 16px; }
  @keyframes hintFloat {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.7; }
    50% { transform: translateX(-50%) translateY(6px); opacity: 1; }
  }

  /* ============ 滚动显现（可重复触发） ============ */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* ============ 通用分区 ============ */
  .section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px 88px;
  }
  .section-last { padding-bottom: 96px; }
  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 44px;
  }
  .section-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    text-align: left;
    max-width: none;
    margin: 0 0 36px;
  }
  .section-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--primary);
    margin-bottom: 10px;
  }
  .section-title {
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 10px;
  }
  .section-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* ============ 数据带 ============ */
  .stats-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    margin-bottom: 88px;
  }
  .stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .stat-item + .stat-item { border-left: 1px solid var(--border); }
  .stat-num {
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 12.5px;
    color: var(--text-tertiary);
  }

  /* ============ 核心能力 ============ */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .feature-card {
    padding: 26px 24px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .feature-card.in:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
