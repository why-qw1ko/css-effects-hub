  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--primary-dim);
    color: var(--primary);
    margin-bottom: 16px;
  }
  .feature-icon svg { width: 20px; height: 20px; }
  .feature-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }
  .feature-desc {
    font-size: 13px;
