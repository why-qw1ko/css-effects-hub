  /* ============ 精选动效卡片 ============ */
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .feat-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
