---
import MainLayout from '../layouts/MainLayout.astro';
import EffectGrid from '../components/effects/EffectGrid.vue';
---

<MainLayout>
  <div class="min-h-screen">
    <!-- Hero -->
    <section class="relative py-16 md:py-20">
      <div class="max-w-[1400px] mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary-dim rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          <span class="font-mono text-xs text-primary font-medium">Interactive Showcase</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
          CSS <em class="font-serif italic font-normal text-primary not-italic">Design</em> Plus
        </h1>
        <p class="font-mono text-sm text-txt-secondary max-w-xl mx-auto leading-relaxed">
          精选 CSS 动效合集，每个效果均可实时预览。点击查看详情获取完整代码与 AI Prompt。
        </p>
      </div>
    </section>

    <!-- Effects Grid -->
    <section class="max-w-[1400px] mx-auto px-6 pb-16">
      <EffectGrid client:load />
    </section>
  </div>
</MainLayout>
