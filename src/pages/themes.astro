// Render
const container = document.getElementById('themes-container')!;
const sidebar = document.getElementById('theme-sidebar')!;

// Sidebar
themes.forEach((theme, idx) => {
  const item = document.createElement('div');
  item.className = 'sidebar-item' + (idx === 0 ? ' active' : '');
  item.innerHTML = `<span class="sidebar-dot" style="background:${theme.dot}"></span>${theme.name}`;
  item.onclick = () => {
    document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
    item.classList.add('active');
    document.getElementById('theme-' + idx)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  sidebar.appendChild(item);
});

// UI 图标统一取自页面预渲染的 lucide 图标模板（#themeIconDefs）
const themeIconDefs = document.getElementById('themeIconDefs');
const themeIcon = (name: string) =>
  themeIconDefs?.querySelector(`[data-icon="${name}"]`)?.innerHTML ?? '';
const ICONS = {
  copy: themeIcon('copy'),
  chevronDown: themeIcon('chevron-down'),
  check: themeIcon('check'),
};

// Cards
themes.forEach((theme, idx) => {
  const card = document.createElement('div');
  card.className = 'theme-card';
  card.id = 'theme-' + idx;

  const l = theme.light;
  const d = theme.dark;

  card.innerHTML = `
    <div class="theme-card-header" onclick="toggleThemeCard(${idx})">
      <div class="theme-card-title">
        <h3>${theme.name}</h3>
        <div class="color-dots">
          <span style="background:${l.primary}"></span>
          <span style="background:${l.bg}"></span>
          <span style="background:${d.bg}"></span>
          <span style="background:${d.primary}"></span>
        </div>
      </div>
      <div class="theme-card-actions">
        <button class="btn-copy" onclick="event.stopPropagation(); copyThemeSpec(${idx}, this)">
          ${ICONS.copy}
          复制规范
        </button>
        <button class="btn-expand" onclick="event.stopPropagation(); toggleThemeCard(${idx})">
          ${ICONS.chevronDown}
          展开
        </button>
      </div>
    </div>
    <div class="color-preview">
      <div class="color-swatch"><div class="swatch" style="background:${l.bg}"></div><span class="swatch-label">Light BG</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.card}"></div><span class="swatch-label">Card</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.primary}"></div><span class="swatch-label">Primary</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.primary}80"></div><span class="swatch-label">Hover</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.primary}20"></div><span class="swatch-label">Light</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.danger}"></div><span class="swatch-label">Danger</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.success}"></div><span class="swatch-label">Success</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${l.warning}"></div><span class="swatch-label">Warning</span></div>
      <div class="color-swatch" style="margin-left:12px"><div class="swatch" style="background:${d.bg}"></div><span class="swatch-label">Dark BG</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.card}"></div><span class="swatch-label">Card</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.primary}"></div><span class="swatch-label">Primary</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.primary}80"></div><span class="swatch-label">Hover</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.primary}20"></div><span class="swatch-label">Light</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.danger}"></div><span class="swatch-label">Danger</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.success}"></div><span class="swatch-label">Success</span></div>
      <div class="color-swatch"><div class="swatch" style="background:${d.warning}"></div><span class="swatch-label">Warning</span></div>
    </div>
    <div class="theme-card-body" id="theme-body-${idx}">
      <pre class="theme-spec">${theme.spec}</pre>
    </div>
  `;
  container.appendChild(card);
});

// Interactions
function toggleThemeCard(idx: number) {
  document.getElementById('theme-body-' + idx)?.classList.toggle('open');
}
(window as any).toggleThemeCard = toggleThemeCard;

function copyThemeSpec(idx: number, btn: HTMLElement) {
  navigator.clipboard.writeText(themes[idx].spec).then(() => {
    btn.classList.add('copied');
    btn.innerHTML = `${ICONS.check} 已复制`;
    showToast(themes[idx].name + ' 规范已复制');
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = `${ICONS.copy} 复制规范`;
    }, 2000);
  });
}
(window as any).copyThemeSpec = copyThemeSpec;

// Expand all
document.getElementById('expandAllBtn')?.addEventListener('click', () => {
  const bodies = document.querySelectorAll('.theme-card-body');
  const allOpen = [...bodies].every(b => b.classList.contains('open'));
  bodies.forEach(b => b.classList.toggle('open', !allOpen));
});

// Toast
function showToast(msg: string) {
  let toast = document.querySelector('.toast-msg') as HTMLElement;
  if (!toast) {
    toast = document.createElement('div');
    toast.className = 'toast-msg';
    document.body.appendChild(toast);
  }
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2500);
}
</script>
