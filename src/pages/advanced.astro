    code: {
      html: `<div class="scramble" data-text="Web Effects">Web Effects</div>`,
      css: `.scramble {
  font-family: monospace;
  font-size: 24px;
  font-weight: 700;
}`,
      js: `const el = document.querySelector('.scramble');
const chars = '!@#$%^&*0123456789ABCDEF';
function scramble(text) {
  const len = text.length;
  let frame = 0;
  const maxFrame = len * 4;
  const interval = setInterval(() => {
    frame++;
    let result = '';
    for (let i = 0; i < len; i++) {
      result += frame > len * 2 ? text[i] : chars[Math.floor(Math.random() * chars.length)];
    }
    el.textContent = result;
    if (frame >= maxFrame) { clearInterval(interval); el.textContent = text; }
  }, 35);
}
scramble(el.dataset.text);`
