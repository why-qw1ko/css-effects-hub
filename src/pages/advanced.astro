    demoJs: `(function(){const w=document.getElementById('cntWDemo');if(!w)return;let done=false;const o=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting&&!done){done=true;w.querySelectorAll('.cnt-num-demo').forEach(n=>{const t=parseInt(n.dataset.target),d=2000;let st=null;function step(ts){if(!st)st=ts;const p=Math.min((ts-st)/d,1);n.textContent=Math.floor((1-Math.pow(1-p,3))*t).toLocaleString();if(p<1)requestAnimationFrame(step)}requestAnimationFrame(step)})}if(e.isIntersecting)o.unobserve(e.target)})},{threshold:.3});o.observe(w)})();`,
    code: {
      html: `<div class="counter" data-target="2048">0</div>`,
      css: `.counter {
  font-size: 48px;
  font-weight: 800;
  color: #1a1d26;
}`,
      js: `function animateCounter(el) {
  const target = parseInt(el.dataset.target);
  const duration = 2000;
  let startTime = null;
  function step(timestamp) {
    if (!startTime) startTime = timestamp;
    const progress = Math.min((timestamp - startTime) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.floor(eased * target).toLocaleString();
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

const io = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      animateCounter(entry.target);
      io.unobserve(entry.target);
    }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.counter').forEach((el) => io.observe(el));`
