      js: `// 纯 CSS 实现，关键是 background-size:400% + 移动 background-position`
    }
  },
  {
    id: 'neon', cat: 'atm', tag: '氛围质感', tagClass: 'adv-tag-atmo',
    name: 'Neon Pulse', nameCn: '霓虹脉冲', desc: '文字霓虹灯发光脉冲。',
    prompt: 'text-shadow叠加多层白色+主题色模糊，animation alternate脉冲。',
    demoHtml: '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#0d0d0d"><span style="font-family:var(--font-display);font-size:36px;font-weight:800;color:#fff;animation:neonP 2s ease-in-out infinite alternate">NEON</span></div>',
    demoCss: '',
    demoJs: '',
    code: {
      html: `<div class="neon-scene">
  <span class="neon-text">NEON</span>
</div>`,
      css: `.neon-scene {
