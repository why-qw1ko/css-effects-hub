---
import MainLayout from '../../layouts/MainLayout.astro';
import EffectDetail from '../../components/effects/EffectDetail.vue';
import CodeBlock from '../../components/effects/CodeBlock.vue';
import { effects, categories, previewKeyframes } from '../../data/effects';

export function getStaticPaths() {
  return effects.map(effect => ({
    params: { id: effect.id },
    props: { effect },
  }));
}

const { effect } = Astro.props;
const cat = categories.find(c => c.id === effect.category);
---

<MainLayout>
  <div class="max-w-[900px] mx-auto px-6 py-10">
    <!-- Back -->
    <a href={import.meta.env.BASE_URL + 'effects'} class="inline-flex items-center gap-2 font-mono text-sm text-txt-secondary hover:text-primary transition-colors mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      返回动效库
    </a>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="badge badge-blue">{cat?.name || effect.category}</span>
        <span class="font-mono text-xs text-txt-tertiary">{effect.nameEn}</span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-extrabold text-txt mb-3">{effect.name}</h1>
      <p class="font-mono text-sm text-txt-secondary leading-relaxed">{effect.description}</p>
    </div>

    <!-- Preview -->
    <div class="mb-8">
      <h2 class="font-display font-bold text-sm text-txt-tertiary uppercase tracking-wider mb-3">👀 预览</h2>
      <div class="preview-container rounded-card border border-border" style="height: 280px" set:html={effect.previewHtml}></div>
    </div>

    <!-- HTML Code -->
    <div class="mb-6">
      <h2 class="font-display font-bold text-sm text-txt-tertiary uppercase tracking-wider mb-3">📄 HTML</h2>
      <CodeBlock code={effect.html} label="HTML" client:load />
    </div>

    <!-- CSS Code -->
    <div class="mb-6">
      <h2 class="font-display font-bold text-sm text-txt-tertiary uppercase tracking-wider mb-3">🎨 CSS</h2>
      <CodeBlock code={effect.css} label="CSS" client:load />
    </div>

    <!-- JS Code -->
    {effect.js && (
      <div class="mb-6">
        <h2 class="font-display font-bold text-sm text-txt-tertiary uppercase tracking-wider mb-3">⚡ JavaScript</h2>
        <CodeBlock code={effect.js} label="JavaScript" client:load />
      </div>
    )}

    <!-- AI Prompt -->
    <div class="mb-8">
      <h2 class="font-display font-bold text-sm text-txt-tertiary uppercase tracking-wider mb-3">🤖 AI Prompt</h2>
      <div class="bg-surface border border-border rounded-card p-5">
        <p class="font-mono text-sm text-txt-secondary leading-relaxed mb-4">{effect.prompt}</p>
        <button id="copyPromptBtn" class="btn-primary text-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          复制 Prompt
        </button>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2">
      {effect.tags.map(tag => (
        <span class="font-mono text-xs px-3 py-1.5 rounded-full bg-surface border border-border text-txt-secondary">{tag}</span>
      ))}
    </div>
  </div>

  <script define:vars={{ prompt: effect.prompt }}>
    document.getElementById('copyPromptBtn')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt);
        const btn = document.getElementById('copyPromptBtn');
        if (btn) {
          btn.textContent = '已复制 ✓';
          setTimeout(() => { btn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> 复制 Prompt'; }, 2000);
        }
      } catch {}
    });
  </script>
</MainLayout>
