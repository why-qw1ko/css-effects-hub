---
import MainLayout from '../../layouts/MainLayout.astro';
import CodeBlock from '../../components/effects/CodeBlock.vue';
import { Icon } from 'astro-icon/components';
import { effects, categories } from '../../data/effects';

export function getStaticPaths() {
  return effects.map(effect => ({
    params: { id: effect.id },
    props: { effect },
  }));
}

const { effect } = Astro.props;
const base = import.meta.env.BASE_URL;
const cat = categories.find(c => c.id === effect.category);

// 同分类上一个 / 下一个动效
const idx = effects.findIndex(e => e.id === effect.id);
const prev = idx > 0 ? effects[idx - 1] : null;
const next = idx < effects.length - 1 ? effects[idx + 1] : null;

const badgeMap: Record<string, string> = {
  basic: 'badge-blue', text: 'badge-purple', color: 'badge-orange',
  geometry: 'badge-green', loading: 'badge-pink', hover: 'badge-green',
  scroll: 'badge-blue', button: 'badge-orange', transition: 'badge-purple',
  advanced: 'badge-pink', micro: 'badge-orange',
};
const badgeClass = badgeMap[effect.category] || 'badge-gray';

const difficultyMap: Record<string, { label: string; cls: string }> = {
  easy: { label: '入门', cls: 'badge-green' },
  medium: { label: '进阶', cls: 'badge-orange' },
  hard: { label: '高级', cls: 'badge-pink' },
};
const diff = difficultyMap[effect.difficulty] || difficultyMap.easy;
---

<MainLayout>
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-8">
    <!-- Back -->
    <a href={base + 'effects'} class="inline-flex items-center gap-2 font-sans text-sm text-txt-secondary hover:text-primary transition-colors mb-6">
      <Icon name="lucide:arrow-left" class="w-4 h-4" />
      返回动效库
    </a>

    <div class="lg:grid lg:grid-cols-[minmax(0,440px)_minmax(0,1fr)] lg:gap-8 lg:items-start">
      <!-- Left: sticky preview + info -->
      <div class="lg:sticky lg:top-[84px] mb-8 lg:mb-0">
        <div class="bg-card border border-border rounded-xl overflow-hidden">
          <div class="preview-container relative" style="height: 300px" set:html={effect.previewHtml}></div>
          <div class="p-6">
            <div class="flex items-center flex-wrap gap-2 mb-3">
              <span class={`badge ${badgeClass}`}>{cat?.name || effect.category}</span>
              <span class={`badge ${diff.cls}`}>{diff.label}</span>
              <span class="font-mono text-xs text-txt-tertiary ml-auto">{effect.nameEn}</span>
            </div>
            <h1 class="font-display text-2xl md:text-3xl font-extrabold text-txt mb-2">{effect.name}</h1>
            <p class="font-sans text-sm text-txt-secondary leading-relaxed mb-4">{effect.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {effect.tags.map(tag => (
                <span class="font-sans text-[11px] px-2.5 py-1 rounded-full bg-surface border border-border text-txt-tertiary">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right: code + prompt -->
      <div class="min-w-0 space-y-6">
        <!-- AI Prompt -->
        <div class="bg-card border border-border rounded-xl overflow-hidden">
          <div class="flex items-center justify-between gap-3 px-5 py-3 bg-surface border-b border-border">
            <div class="flex items-center gap-2">
              <Icon name="lucide:bot" class="w-4 h-4 text-primary" />
              <span class="font-mono text-[11px] font-semibold tracking-wider text-txt uppercase">AI Prompt</span>
              <span class="font-sans text-[11px] text-txt-tertiary hidden sm:inline">复制给 AI 一键复刻此动效</span>
            </div>
            <button id="copyPromptBtn" class="btn-primary !px-3.5 !py-1.5 text-xs flex-shrink-0">
              <Icon name="lucide:copy" class="w-3.5 h-3.5" />
              复制 Prompt
            </button>
          </div>
          <p class="font-mono text-[13px] text-txt-secondary leading-relaxed p-5">{effect.prompt}</p>
        </div>

        <!-- HTML -->
        <div>
          <h2 class="font-mono font-semibold text-[11px] text-txt-tertiary uppercase tracking-widest mb-2.5">HTML</h2>
          <CodeBlock code={effect.html} label="HTML" client:load />
        </div>

        <!-- CSS -->
        <div>
          <h2 class="font-mono font-semibold text-[11px] text-txt-tertiary uppercase tracking-widest mb-2.5">CSS</h2>
          <CodeBlock code={effect.css} label="CSS" client:load />
        </div>

        <!-- JS -->
        {effect.js && (
          <div>
            <h2 class="font-mono font-semibold text-[11px] text-txt-tertiary uppercase tracking-widest mb-2.5">JavaScript</h2>
            <CodeBlock code={effect.js} label="JavaScript" client:load />
          </div>
        )}
      </div>
    </div>

    <!-- Prev / Next -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
      {prev ? (
        <a href={`${base}effect/${prev.id}`} class="group flex items-center gap-3 bg-card border border-border rounded-xl px-5 py-4 no-underline hover:border-primary transition-colors">
          <Icon name="lucide:chevron-left" class="w-4 h-4 text-txt-tertiary group-hover:text-primary transition-colors flex-shrink-0" />
          <div class="min-w-0">
            <div class="font-sans text-[11px] text-txt-tertiary mb-0.5">上一个</div>
            <div class="font-display font-bold text-sm text-txt group-hover:text-primary transition-colors truncate">{prev.name}</div>
          </div>
        </a>
      ) : <div class="hidden sm:block"></div>}
      {next && (
        <a href={`${base}effect/${next.id}`} class="group flex items-center justify-end gap-3 bg-card border border-border rounded-xl px-5 py-4 no-underline hover:border-primary transition-colors text-right">
          <div class="min-w-0">
            <div class="font-sans text-[11px] text-txt-tertiary mb-0.5">下一个</div>
            <div class="font-display font-bold text-sm text-txt group-hover:text-primary transition-colors truncate">{next.name}</div>
          </div>
          <Icon name="lucide:chevron-right" class="w-4 h-4 text-txt-tertiary group-hover:text-primary transition-colors flex-shrink-0" />
        </a>
      )}
    </div>
  </div>

  <script define:vars={{ prompt: effect.prompt }}>
    const copyBtn = document.getElementById('copyPromptBtn');
    const copyBtnHtml = copyBtn ? copyBtn.innerHTML : '';
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt);
        if (copyBtn) {
          copyBtn.textContent = '已复制 ✓';
          setTimeout(() => { copyBtn.innerHTML = copyBtnHtml; }, 2000);
        }
      } catch {}
    });
  </script>
</MainLayout>
