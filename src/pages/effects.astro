---
import MainLayout from '../layouts/MainLayout.astro';
import EffectGrid from '../components/effects/EffectGrid.vue';
---

<MainLayout>
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-card border-b border-border">
      <div class="max-w-[1400px] mx-auto px-6 py-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary-dim rounded-full mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          <span class="font-sans text-xs text-primary font-medium">Effect Library</span>
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-extrabold text-txt mb-3">动效库</h1>
        <p class="font-sans text-sm text-txt-secondary max-w-2xl">
          探索所有 CSS 动效，按分类筛选或搜索关键词，点击卡片查看完整代码与 AI Prompt。
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-[1400px] mx-auto px-6 py-8">
      <EffectGrid client:load />
    </div>
  </div>
</MainLayout>
