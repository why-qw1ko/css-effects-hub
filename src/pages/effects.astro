---
import MainLayout from '../layouts/MainLayout.astro';
import EffectCard from '../components/effects/EffectCard.vue';
import SearchBar from '../components/ui/SearchBar.vue';
import CategoryNav from '../components/ui/CategoryNav.vue';
import EffectDetail from '../components/effects/EffectDetail.vue';
import { effects, categories } from '../data/effects';

const allCategories = [
  { id: 'all', name: '全部', nameEn: 'All', icon: '🎯', count: effects.length },
  ...categories.map(cat => ({
    ...cat,
    count: effects.filter(e => e.category === cat.id).length,
  })).filter(cat => cat.count > 0),
];
---

<MainLayout>
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-card border-b border-border">
      <div class="max-w-[1400px] mx-auto px-6 py-12 text-center">
        <h1 class="font-display text-3xl md:text-4xl font-extrabold text-txt mb-3">动效库</h1>
        <p class="font-mono text-sm text-txt-secondary">探索所有 CSS 动效，点击查看详情</p>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-[1400px] mx-auto px-6 py-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-6">
        <CategoryNav categories={allCategories} active="all" client:load />
        <SearchBar modelValue="" client:load />
      </div>

      <div class="font-mono text-xs text-txt-tertiary mb-4">
        显示 <span class="text-primary font-medium">{effects.length}</span> / {effects.length}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {effects.map(effect => (
          <a href={`/effect/${effect.id}`} class="block no-underline">
            <EffectCard effect={effect} client:load />
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
